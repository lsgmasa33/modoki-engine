{
  "app": {
    "appId": "com.modokiengine.physicsdemo",
    "appName": "2D Physics Demo",
    "iconSource": ""
  },
  "content": {
    "scenes": []
  },
  "build": {
    "webDeployMode": "none",
    "webBucket": "",
    "webBasePath": "/",
    "webCdnUrlMap": "",
    "webCdnBackendBucket": "",
    "webDeployCommand": "",
    "appleTeamId": "",
    "debugBuild": false
  },
  "capacitor": {
    "webDir": "dist",
    "iosContentMode": "mobile",
    "androidScheme": "http",
    "allowMixedContent": true,
    "keyboardResize": "none",
    "orientation": "auto",
    "statusBarHidden": false,
    "statusBarStyle": "default"
  },
  "rendering": {
    "targetFps": 60,
    "three": {
      "backend": "auto",
      "antialias": true,
      "pixelRatioCap": 2,
      "shadows": true,
      "toneMapping": "ACESFilmic",
      "exposure": 1.2,
      "tiers": {
        "mid": {
          "pixelRatioCap": 1.5,
          "antialias": false,
          "shadows": true,
          "shadowMapCeiling": 1024,
          "postFX": {
            "npr": false,
            "ao": false,
            "dof": false,
            "bloom": false,
            "vignette": false
          },
          "maxDirectional": 2,
          "maxLocal": 3,
          "ibl": true,
          "iblOffAmbientBoost": 1,
          "iblOffExposure": 1,
          "targetFps": 0,
          "pixiPixelRatioCap": 1,
          "pixiAntialias": false,
          "textureMaxSize": 1024,
          "maxShadowCasters": 1,
          "hysteresisMargin": 0.15
        },
        "low": {
          "pixelRatioCap": 1,
          "antialias": false,
          "shadows": false,
          "shadowMapCeiling": 512,
          "postFX": {
            "npr": false,
            "ao": false,
            "dof": false,
            "bloom": false,
            "vignette": false
          },
          "maxDirectional": 1,
          "maxLocal": 1,
          "ibl": false,
          "iblOffAmbientBoost": 4,
          "iblOffExposure": 1.25,
          "targetFps": 30,
          "pixiPixelRatioCap": 1,
          "pixiAntialias": false,
          "textureMaxSize": 512,
          "maxShadowCasters": 1,
          "hysteresisMargin": 0.15
        }
      }
    },
    "pixi": {
      "backend": "auto",
      "antialias": true,
      "resolution": 0
    },
    "web": {
      "sizeMode": "free",
      "width": 1280,
      "height": 720
    }
  },
  "physics": {
    "layers": [
      "Default",
      "Ground",
      "Ghost"
    ],
    "collisionMatrix": [
      3,
      7,
      2
    ]
  },
  "postprocessors": {}
}
