{
  "app": {
    "appId": "com.modokiengine.physicsdemo",
    "appName": "2D Physics Demo",
    "iconSource": ""
  },
  "content": {
    "scenes": []
  },
  "build": {
    "webDeployMode": "none",
    "webBucket": "",
    "webBasePath": "/",
    "webCdnUrlMap": "",
    "webCdnBackendBucket": "",
    "webDeployCommand": "",
    "appleTeamId": "",
    "debugBuild": false
  },
  "capacitor": {
    "webDir": "dist",
    "iosContentMode": "mobile",
    "androidScheme": "http",
    "allowMixedContent": true,
    "keyboardResize": "none",
    "orientation": "auto",
    "statusBarHidden": false,
    "statusBarStyle": "default"
  },
  "rendering": {
    "targetFps": 60,
    "three": {
      "backend": "auto",
      "antialias": true,
      "pixelRatioCap": 2,
      "shadows": true,
      "toneMapping": "ACESFilmic",
      "exposure": 1.2
    },
    "pixi": {
      "backend": "auto",
      "antialias": true,
      "resolution": 0
    },
    "web": {
      "sizeMode": "free",
      "width": 1280,
      "height": 720
    }
  },
  "physics": {
    "layers": [
      "Default",
      "Ground",
      "Ghost"
    ],
    "collisionMatrix": [
      3,
      7,
      2
    ]
  },
  "postprocessors": {}
}
