{
  "name": "modoki-engine",
  "private": true,
  "version": "0.3.8",
  "type": "module",
  "description": "Modoki — a Claude-friendly game engine + visual editor",
  "author": "Modoki",
  "main": "engine/electron/dist/main.cjs",
  "workspaces": [
    "engine/packages/*"
  ],
  "//engines": "Node 24 is Active LTS (to 2028-04-30); 22 went maintenance-only 2025-10-21. Keep in lockstep with @types/node, PINNED_NODE in engine/toolchain/nodeProvision.ts, and node-version in all three workflows — types above the runtime typecheck clean, then fail at RUNTIME in the packaged editor.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config engine/vite.config.ts",
    "build:plugins": "npm run build --workspace engine/packages/capacitor-game-debug --workspace engine/packages/capacitor-litert-lm --workspace engine/packages/capacitor-modoki-ota",
    "postinstall": "npm run build:plugins && node engine/scripts/bootstrap-mcp-deps.mjs && node engine/scripts/bootstrap-game-deps.mjs",
    "electron:build": "node engine/scripts/build-electron.mjs",
    "dev:electron": "npm run electron:build && electron engine/electron/dist/main.cjs",
    "build:editor": "cross-env MODOKI_EDITOR=true vite build --config engine/vite.config.ts",
    "build:electron": "npm run build:editor && npm run electron:build",
    "preview:electron": "npm run electron:build && npm run dev:stop; MODOKI_PROD=1 electron engine/electron/dist/main.cjs",
    "dist": "npm run build:electron && electron-builder --publish never",
    "dist:notarized": "bash engine/scripts/dist-notarized.sh",
    "dist:mac": "npm run build:electron && electron-builder --mac --publish never",
    "dist:win": "npm run build:electron && electron-builder --win --publish never",
    "dist:dir": "npm run build:electron && electron-builder --dir",
    "dev:stop": "bash engine/scripts/stop-dev.sh",
    "editor:stop": "bash engine/scripts/stop-editor.sh",
    "clean:texture-cache": "node engine/scripts/clean-texture-cache.mjs",
    "clean:packaged-cache": "node engine/scripts/clean-packaged-cache.mjs",
    "sync:agent-configs": "node engine/scripts/sync-agent-configs.mjs",
    "docs:api": "typedoc",
    "build": "node engine/scripts/build-web.mjs",
    "typecheck": "tsc -b engine && tsc -p engine/tsconfig.test.json && npm --prefix engine/packages/modoki run typecheck && npm --prefix engine/tools/modoki-mcp run typecheck && npm --prefix engine/tools/game-debug-mcp run typecheck",
    "typecheck:projects": "node engine/scripts/typecheck-projects.mjs",
    "lint": "eslint --config engine/eslint.config.js --cache --cache-strategy content --cache-location node_modules/.tmp/.eslintcache .",
    "verify": "node engine/scripts/verify.mjs",
    "verify:serial": "npm run typecheck && npm run lint && npm test && npm --prefix engine/packages/modoki test",
    "verify:all": "npm run verify && npm run test:e2e",
    "verify:packaged": "npm run verify && npm run smoke:packaged",
    "verify:publish": "scripts/publish-engine-oss.sh --with-demos=3d-physics-demo,2d-physics-demo",
    "hooks:install": "node engine/scripts/install-git-hooks.mjs",
    "prepare": "node engine/scripts/install-git-hooks.mjs",
    "preview": "vite preview --config engine/vite.config.ts",
    "test": "vitest run --config engine/vite.config.ts",
    "test:watch": "vitest --config engine/vite.config.ts",
    "coverage": "npm --prefix engine/packages/modoki test -- --coverage && cross-env MODOKI_COVERAGE_ENGINE_ONLY=1 vitest run --config engine/vite.config.ts --coverage && node engine/scripts/merge-coverage.mjs",
    "test:framework": "vitest run --config engine/vite.config.ts engine/tests/framework",
    "test:game": "vitest run --config engine/vite.config.ts engine/tests/game",
    "test:e2e": "playwright test --config engine/playwright.config.ts",
    "test:packaged": "bash engine/scripts/test-packaged.sh",
    "smoke:packaged": "bash engine/scripts/smoke-packaged.sh",
    "smoke:playable": "node engine/scripts/smoke-playable.mjs",
    "smoke:debug-flag": "node engine/scripts/smoke-debug-build-flag.mjs",
    "smoke:mcp": "npm --prefix engine/tools/modoki-mcp run smoke",
    "editor": "bash engine/scripts/relaunch-editor.sh",
    "editor:main": "MODOKI_BACKEND_PORT=5179 bash engine/scripts/launch-editor.sh games/3d-test",
    "editor:ai": "MODOKI_BACKEND_PORT=5180 bash engine/scripts/launch-editor.sh games/3d-test",
    "editor:main:packaged": "MODOKI_BACKEND_PORT=5179 bash engine/scripts/test-packaged.sh games/3d-test",
    "editor:ai:packaged": "MODOKI_BACKEND_PORT=5180 bash engine/scripts/test-packaged.sh games/3d-test",
    "test:mcp:live": "npm --prefix engine/tools/modoki-mcp run test:live && npm --prefix engine/tools/modoki-mcp run smoke"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/keyboard": "^8.0.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@modoki/engine": "file:engine/packages/modoki",
    "@monogrid/gainmap-js": "^3.4.0",
    "@pixi/react": "^8.0.5",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@zappar/msdf-generator": "^1.2.4",
    "capacitor-game-debug": "file:engine/packages/capacitor-game-debug",
    "capacitor-litert-lm": "file:engine/packages/capacitor-litert-lm",
    "capacitor-modoki-ota": "file:engine/packages/capacitor-modoki-ota",
    "chess.js": "^1.4.0",
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "flexlayout-react": "^0.8.19",
    "koota": "^0.6.5",
    "maxrects-packer": "^2.7.3",
    "meshoptimizer": "^1.0.1",
    "pixi.js": "^8.17.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sharp": "^0.35.0",
    "tar": "^7.5.22",
    "three": "^0.184.0",
    "vite": "^8.0.5",
    "yauzl": "^2.10.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.3.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.7",
    "esbuild": "^0.28.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^30.0.1",
    "smol-toml": "^1.7.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.2"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.60.1",
    "@rollup/rollup-linux-x64-gnu": "4.60.1",
    "@rollup/rollup-win32-x64-msvc": "4.60.1",
    "canvas": "^3.2.3",
    "fsevents": "^2.3.3"
  },
  "overrides": {
    "sharp": "^0.35.0",
    "minimatch@10.2.5": {
      "brace-expansion": "^5.0.8"
    },
    "brace-expansion@1": "^1.1.18",
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  }
}
