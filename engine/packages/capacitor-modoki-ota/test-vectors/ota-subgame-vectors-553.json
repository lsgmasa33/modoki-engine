{
  "_comment": "Sub-game load-failure vectors (#553/#550) — the demotion path a sub-game bundle never had. Replayed by BOTH platforms (OtaCoreTests.swift and OtaCoreSelfTest.java) alongside the Phase 1 golden vectors and the Phase 3a gate vectors; all three must produce identical results.",
  "_why": "#553: `listBundles()` preferred `active` over `pending`, so a sub-game update was promoted to `active` on the strength of two successful loads of the version it REPLACES, having never once executed. Device-verified offline on a Galaxy S22, 2026-09-01. The fix is two-sided and both sides are specified here: `confirm` may name the version it is confirming (a mismatch is a no-op), and `loadFailed` gives a sub-game the revert/quarantine the shell has had since Phase 3a. Disposition semantics are the load-bearing part — see OtaCore.swift's OtaLoadFailure doc. Three later scenarios cover the ACTIVE slot: `bootAttempts` is a PENDING-only counter, so a `transient` failure of an already-promoted version has nothing to count and nothing to exhaust — it must clear `active` (never quarantine) or it would be refused every launch forever with no escalation, which is the very shape this file exists to prevent.",
  "constants": {
    "maxAttempts": 3,
    "requiredConfirms": 2
  },
  "scenarios": [
    {
      "name": "fatal_pending_reverts_to_active_and_QUARANTINES",
      "op": "loadFailed",
      "bundle": "subgame",
      "version": "v2",
      "disposition": "fatal",
      "state": {
        "active": {
          "subgame": "v1"
        },
        "pending": {
          "subgame": "v2"
        },
        "bootAttempts": {
          "subgame": 1
        },
        "confirmedBoots": {
          "subgame": 1
        }
      },
      "folderExists": {
        "subgame/v1": true,
        "subgame/v2": true
      },
      "expect": {
        "target": {
          "kind": "version",
          "name": "subgame",
          "version": "v1"
        },
        "state": {
          "active": {
            "subgame": "v1"
          },
          "rejected": {
            "subgame": [
              "v2"
            ]
          }
        }
      }
    },
    {
      "name": "fatal_pending_with_no_active_falls_back_to_embedded_and_QUARANTINES",
      "op": "loadFailed",
      "bundle": "subgame",
      "version": "v1",
      "disposition": "fatal",
      "state": {
        "pending": {
          "subgame": "v1"
        },
        "bootAttempts": {
          "subgame": 1
        }
      },
      "folderExists": {
        "subgame/v1": true
      },
      "expect": {
        "target": {
          "kind": "embedded"
        },
        "state": {
          "rejected": {
            "subgame": [
              "v1"
            ]
          }
        }
      }
    },
    {
