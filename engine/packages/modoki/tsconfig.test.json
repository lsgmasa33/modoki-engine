{
  // Typechecks the package's OWN test suite (tests/**), which tsconfig.json deliberately
  // excludes (`"exclude": ["tests", "dist"]` — it is the emit config, and tests must not
  // be emitted into dist/). That exclusion left all 451 files here transpiled-but-never-
  // typechecked, so a mock could drift from the module it stands in for and `npm test`
  // would stay green. See issue #23.
  //
  // Extends tsconfig.check.json (not tsconfig.json) for the same reason it exists: the
  // build config's `paths` map `react`/`zustand` straight at the JS package and bypass
  // @types resolution, which breaks JSX and hook types in the .tsx suites.
  "extends": "./tsconfig.check.json",
  "compilerOptions": {
    // Tests drive build-time/node code and use vitest globals (test.globals is true);
    // src/ deliberately gets neither.
    "types": ["vite/client", "vitest/globals", "node"],
    // The inherited `rootDir: "./src"` (a real constraint for the emit config) makes every
    // file under tests/ a TS6059 "not under rootDir". Nothing is emitted here, so widen it.
    "rootDir": "."
  },
  // `exclude` MUST be re-stated: it is INHERITED through tsconfig.check.json from
  // tsconfig.json, where it lists "tests" — an inherited exclude beats a local include, so
  // without this the config compiles zero test files and reports a cheerful clean run.
  "exclude": ["dist"],
  "include": ["tests", "src/**/*.d.ts"]
}
